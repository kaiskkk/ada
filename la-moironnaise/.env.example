# Copiez ce fichier en « .env » et remplissez-le. Le fichier .env n'est jamais envoyé sur GitHub.

# Compte administrateur créé au premier démarrage
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Adresse publique du site, utilisée dans les QR codes (sans / à la fin).
# Laissez vide pour utiliser automatiquement l'adresse de la page.
PUBLIC_URL=

# Port du serveur (3000 par défaut)
PORT=3000

# Dossier où est rangée la base de données (./data par défaut)
DATA_DIR=
